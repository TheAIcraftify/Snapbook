# ============================================================================
# SnapBook — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values when you're ready
# to connect live services. The app runs fully in DEMO MODE with none of
# these set — every screen renders using mock data and no-op service calls.
# ============================================================================

# --- Supabase --------------------------------------------------------------
# From: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (payments) ----------------------------------------------------
# From: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Google Maps -------------------------------------------------------------
# From: Google Cloud Console → APIs & Services → Credentials
# Public because it's used client-side for map rendering; restrict it by
# HTTP referrer in the Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Firebase Cloud Messaging (push notifications) --------------------------
# From: Firebase Console → Project Settings → Service Accounts → Generate key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
